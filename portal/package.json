{
  "name": "heatbeat-portal",
  "private": true,
  "version": "0.1.0",
  "description": "Web portal for Heatbeat: portfolio map, plant detail, trends, alarms, parameter changes, recommendations",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "generate:api": "openapi-typescript ../docs/openapi.json -o src/api/schema.d.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "echarts": "5.6.0",
    "leaflet": "1.9.4",
    "openapi-fetch": "0.13.8",
    "pinia": "3.0.4",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@testing-library/vue": "8.1.0",
    "@types/leaflet": "1.9.20",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "4.1.11",
    "vue-tsc": "2.2.12"
  }
}
