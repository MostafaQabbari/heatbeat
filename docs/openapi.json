{
  "components": {
    "schemas": {
      "Bucket": {
        "description": "Allowed time-bucket sizes for series queries.",
        "enum": [
          "1m",
          "5m",
          "15m",
          "1h",
          "1d"
        ],
        "title": "Bucket",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LatestValue": {
        "properties": {
          "datapoint": {
            "title": "Datapoint",
            "type": "string"
          },
          "quality": {
            "title": "Quality",
            "type": "integer"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "datapoint",
          "unit",
          "ts",
          "value",
          "quality"
        ],
        "title": "LatestValue",
        "type": "object"
      },
      "PlantDetail": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "gateway": {
            "title": "Gateway",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "last_seen_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen At"
          },
          "latest": {
            "items": {
              "$ref": "#/components/schemas/LatestValue"
            },
            "title": "Latest",
            "type": "array"
          }
        },
        "required": [
          "key",
          "gateway",
          "created_at",
          "last_seen_at",
          "latest"
        ],
        "title": "PlantDetail",
        "type": "object"
      },
      "PlantPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PlantSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "PlantPage",
        "type": "object"
      },
      "PlantSummary": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "gateway": {
            "title": "Gateway",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "last_seen_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen At"
          }
        },
        "required": [
          "key",
          "gateway",
          "created_at",
          "last_seen_at"
        ],
        "title": "PlantSummary",
        "type": "object"
      },
      "Problem": {
        "description": "Error body following RFC 9457 (application/problem+json).",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Series": {
        "properties": {
          "bucket": {
            "$ref": "#/components/schemas/Bucket"
          },
          "datapoint": {
            "title": "Datapoint",
            "type": "string"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/SeriesPoint"
            },
            "title": "Points",
            "type": "array"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "datapoint",
          "unit",
          "bucket",
          "points"
        ],
        "title": "Series",
        "type": "object"
      },
      "SeriesPoint": {
        "properties": {
          "avg": {
            "title": "Avg",
            "type": "number"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "max": {
            "title": "Max",
            "type": "number"
          },
          "min": {
            "title": "Min",
            "type": "number"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          }
        },
        "required": [
          "ts",
          "avg",
          "min",
          "max",
          "count"
        ],
        "title": "SeriesPoint",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Read API for heating-plant monitoring. All times are UTC (ISO 8601).",
    "title": "Heatbeat API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness: the process is up (does not touch the database).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness: the database answers.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ready Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/plants": {
      "get": {
        "operationId": "list_plants_v1_plants_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Plants",
        "tags": [
          "plants"
        ]
      }
    },
    "/v1/plants/{plant_key}": {
      "get": {
        "operationId": "get_plant_v1_plants__plant_key__get",
        "parameters": [
          {
            "in": "path",
            "name": "plant_key",
            "required": true,
            "schema": {
              "title": "Plant Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Plant not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Plant",
        "tags": [
          "plants"
        ]
      }
    },
    "/v1/plants/{plant_key}/series": {
      "get": {
        "operationId": "get_series_v1_plants__plant_key__series_get",
        "parameters": [
          {
            "in": "path",
            "name": "plant_key",
            "required": true,
            "schema": {
              "title": "Plant Key",
              "type": "string"
            }
          },
          {
            "description": "Datapoint keys",
            "in": "query",
            "name": "dp",
            "required": true,
            "schema": {
              "description": "Datapoint keys",
              "items": {
                "type": "string"
              },
              "maxItems": 10,
              "minItems": 1,
              "title": "Dp",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "From",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "To",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "bucket",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Bucket",
              "default": "5m"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Series"
                  },
                  "title": "Response Get Series V1 Plants  Plant Key  Series Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Plant not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Series",
        "tags": [
          "plants"
        ]
      }
    }
  }
}
