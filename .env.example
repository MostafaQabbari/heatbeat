# What this file does: lists the settings Heatbeat reads. Copy it to .env
# (which git ignores) and set your own values:   Copy-Item .env.example .env

# Required. Used by docker compose for the database AND by the Python code.
HB_DB_PASSWORD=change-me

# Required by the API: at least 32 random characters. Create one in PowerShell:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
HB_JWT_SECRET=

# Password of the demo users created by "docker compose --profile app up" (seed container).
# When you run "uv run heatbeat-seed" yourself, pass --password instead.
HB_DEMO_PASSWORD=change-me-demo

# Optional (defaults shown)
# HB_DB_HOST=127.0.0.1
# HB_MQTT_HOST=127.0.0.1
# HB_REDIS_URL=redis://127.0.0.1:6379/0
# HB_SMTP_HOST=127.0.0.1
# HB_SMTP_PORT=1025
# HB_ALARM_EMAIL_TO=operations@heatbeat.local
# HB_WEBHOOK_URL=
# HB_BATCH_SIZE=200
# HB_RATE_LIMIT_PER_MINUTE=600
# HB_COMMAND_TTL_S=300
# HB_APPROVAL_THRESHOLD=5.0

# For integration tests (uv run pytest -m integration). Use the same password as above.
# HB_TEST_DATABASE_URL=postgresql://heatbeat:change-me@127.0.0.1:5432/heatbeat_test
